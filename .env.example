# Application Settings
APP_NAME=OCR Pipeline API
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Model Paths
MODEL_BASE_PATH=model_path
DETECTION_MODEL_PATH=model_path/text_detection
RECOGNITION_MODEL_PATH=model_path/text_recognition

# Device Settings (cuda, cpu, or mps)
DEVICE=cuda

# Batch Sizes
BATCH_SIZE_DETECTION=4
BATCH_SIZE_RECOGNITION=8

# Model Settings
MAX_TOKENS=500
CONFIDENCE_THRESHOLD=0.3

# File Upload
MAX_FILE_SIZE=104857600

# Allowed MIME Types
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/jpg,image/gif,image/bmp,image/webp
